PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mediconnect
JWT_SECRET=change_this_to_a_long_random_string
ML_URL=http://localhost:5001
CLIENT_URL=http://localhost:5173

# "development" (default) or "production". In production the /api/dev demo routes are switched off.
NODE_ENV=development

# Email (Gmail). EMAIL_PASS must be a Gmail "App password" (Google Account > Security > 2-Step Verification > App passwords),
# NOT your normal Gmail password. If these two are empty the app still works: emails are printed in the server console.
EMAIL_USER=
EMAIL_PASS=

# Razorpay TEST mode keys (https://dashboard.razorpay.com > Settings > API Keys, switch to "Test Mode").
# If empty, checkout shows a clearly labelled "Test payment" button instead (no real gateway needed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Gemini (AI prescription scanner). Get a free key at https://aistudio.google.com/apikey
# If empty, the scanner shows a clear "not configured" message and the rest of the app works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
