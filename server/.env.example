# Copy this file to ".env" and fill it in. Never commit ".env" (it is in .gitignore).

# --- Required: the server will not start without MONGO_URI and JWT_SECRET ---
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mediconnect
# Any long random text. To make one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# --- Addresses of the other two parts of the app ---
ML_URL=http://localhost:5001
CLIENT_URL=http://localhost:5173

# "development" (default) or "production".
# In production: unexpected errors never show their technical message.
NODE_ENV=development

# --- Optional: email (Gmail) ---
# EMAIL_PASS must be a Gmail "App password" (Google Account > Security > 2-Step Verification > App passwords), NOT your normal password.
# If these two are empty the app still works: emails are only printed in the server console. Restart the server after changing them.
EMAIL_USER=
EMAIL_PASS=

# --- Optional: Google Gemini (AI prescription scanner). Free key at https://aistudio.google.com/apikey ---
# If empty, the scanner shows a clear "not configured" message and the rest of the app works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
